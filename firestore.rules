rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can read and write only their own profile/high-score doc.
    // Doc ID == Firebase Auth uid (see lib/services/database.dart).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
